{
  "uid": "attribution-realtime",
  "title": "Attribution Dashboard",
  "tags": [
    "attribution",
    "realtime"
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Attributed Page Views",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": "SQLite",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "rawQueryText": "SELECT COUNT(*) as value FROM attributed_page_views WHERE attributed_campaign_id IS NOT NULL",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Unattributed Page Views",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": "SQLite",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "rawQueryText": "SELECT COUNT(*) as value FROM attributed_page_views WHERE attributed_campaign_id IS NULL",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total Late Events Dropped",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": "SQLite",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "rawQueryText": "SELECT COUNT(*) as value FROM late_events",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Attribution Rate",
      "type": "gauge",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": "SQLite",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "minVizValue": 0,
        "maxVizValue": 100
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          }
        }
      },
      "targets": [
        {
          "rawQueryText": "SELECT ROUND(100.0 * SUM(CASE WHEN attributed_campaign_id IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 1) as value FROM attributed_page_views",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Attributions by Campaign",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": "SQLite",
      "options": {
        "pieType": "pie",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "rawQueryText": "SELECT attributed_campaign_id, COUNT(*) as value FROM attributed_page_views WHERE attributed_campaign_id IS NOT NULL GROUP BY attributed_campaign_id ORDER BY value DESC",
          "queryType": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Late Events by Type",
      "type": "piechart",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": "SQLite",
      "options": {
        "pieType": "pie",
        "legendDisplayMode": "table",
        "placement": "right"
      },
      "targets": [
        {
          "rawQueryText": "SELECT event_type as metric, COUNT(*) as value FROM late_events GROUP BY event_type",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Recent Attributions",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": "SQLite",
      "options": {
        "sortBy": [
          {
            "displayName": "page_view_id",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "rawQueryText": "SELECT page_view_id, user_id, event_time, url, attributed_campaign_id, attributed_click_id FROM attributed_page_views ORDER BY rowid DESC LIMIT 50",
          "queryType": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Watermark Position",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "watermark_position_seconds{application=\"bmw-m2\"}",
          "legendFormat": "Partition {{partition}}",
          "refId": "A"
        }
      ]
    }
  ]
}